{
    "name": "pi-music-hub-backend",
    "version": "1.0.0",
    "description": "backend server for the music hub - serves the touchscreen UI data and pushes now-playing updates over websocket",
    "type": "module",
    "scripts": {
        "dev": "tsx watch src/server.ts",
        "build": "tsc",
        "start": "node dist/server.js"
    },
    "dependencies": {
        "@fastify/cors": "^10.0.0",
        "@fastify/websocket": "^11.0.0",
        "@prisma/client": "^6.19.3",
        "fastify": "^5.0.0"
    },
    "devDependencies": {
        "@types/node": "^22.0.0",
        "@types/ws": "^8.5.10",
        "prisma": "^6.1.0",
        "tsx": "^4.19.0",
        "typescript": "^5.6.0"
    },
    "allowScripts": {
        "esbuild@0.28.1": true
    }
}
