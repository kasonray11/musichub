datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model PlayEvent {
  id       Int      @id @default(autoincrement())
  track    String
  artist   String
  album    String
  playedAt DateTime @default(now())

  @@index([track, artist])
}
